    "constraint/chezhi_audit/chezhi_audit_check": "[true, \"CHECK ((((action = ANY (ARRAY['issue'::text, 'bind'::text, 'unbind'::text, 'revoke'::text])) AND (card_id IS NOT NULL) AND (target = ''::text)) OR ((action = ANY (ARRAY['member-create'::text, 'member-reset'::text, 'member-role'::text, 'member-disable'::text, 'member-enable'::text])) AND (card_id IS NULL) AND (target ~ '^[a-zA-Z][a-zA-Z0-9_-]{2,31}$'::text)) OR ((action = ANY (ARRAY['support_config'::text, 'plans_config'::text, 'login_success'::text, 'login_failed'::text, 'logout'::text, 'logout_all'::text, 'password_changed'::text, 'password_failed'::text])) AND (card_id IS NULL) AND (target = ''::text))))\"]",
